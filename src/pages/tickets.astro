---
import Layout from "../layouts/Layout.astro";

const base = getBaseUrl();
import { getBaseUrl } from "../utils/baseUrl";
---

<Layout
  title="Ticketing Closed | Mac Admins Europe"
  description="Ticketing for Mac Admins Europe 2026 has closed. Browse the 2026 archive for program, speakers, sponsors, and location information."
>
  <section class="page-hero archive-page-hero">
    <div class="container">
      <span class="section-label">2026 Archive</span>
      <h1>Ticketing Closed</h1>
      <p>Mac Admins Europe 2026 has now moved into the conference archive.</p>
    </div>
  </section>

  <section class="archive-content">
    <div class="container">
      <div class="archive-intro">
        <h2>Thank You for Joining Us</h2>
        <p>
          Ticket sales for the 2026 event are no longer active. You can still
          explore the archived program, speaker lineup, sponsors, and Leiden
          venue information.
        </p>
        <div class="hero-cta">
          <a href={`${base}/2026`} class="btn btn-primary">View 2026 Archive</a>
          <a href={`${base}/previous-years`} class="btn btn-outline">Browse Previous Years</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
