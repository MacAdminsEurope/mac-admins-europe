---
import Layout from "../layouts/Layout.astro";
import { getBaseUrl } from "../utils/baseUrl";

const base = getBaseUrl();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Mac Admins Europe",
  url: "https://macadmins-eu.org",
  description:
    "A European, community-driven event for Apple admins and IT professionals.",
};
---

<Layout
  title="Mac Admins Europe | Community Archive"
  description="Thank you to the Mac Admins Europe community. Browse the 2026 archive and previous years for speakers, sponsors, program, and location information."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <section class="hero thank-you-hero">
    <div class="hero-bg">
      <div class="hero-pattern"></div>
    </div>
    <div class="container hero-content">
      <div class="hero-badge">
        <span class="cmd">⌘</span> For the community, by the community
      </div>
      <h1>Thank You, Mac Admins Europe Community</h1>
      <p class="hero-tagline">
        Thank you to everyone who helped make Mac Admins Europe 2026 such a
        meaningful day - attendees, speakers, sponsors, volunteers, and the
        wider Apple admin community.
      </p>
      <p class="hero-description">
        Mac Admins Europe exists because people share knowledge generously,
        support one another, and help keep this community practical, welcoming,
        and strong. Thank you to everyone who joined us in Leiden and helped
        make the 2026 event special.
      </p>
      <div class="hero-cta">
        <a href={`${base}/2026`} class="btn btn-primary">View 2026 Archive</a>
        <a href={`${base}/previous-years`} class="btn btn-secondary">Browse Previous Years</a>
      </div>
    </div>
  </section>

  <section class="community-photo-section">
    <div class="container">
      <figure class="community-photo-frame">
        <img
          src={`${base}/img/archive/2026/community-thank-you.jpg`}
          alt="Mac Admins Europe organizers standing on stage beneath a thank-you screen at the 2026 event"
          loading="lazy"
        />
        <figcaption>
          <span>Mac Admins Europe 2026, Leiden</span>
          <a href="https://zedimages.com" target="_blank" rel="noopener noreferrer">
            Photo credit: ZED Images
          </a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="about archive-home-about" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-content">
          <span class="section-label">Community Archive</span>
          <h2>Keeping the 2026 Event Available</h2>
          <p>
            The 2026 conference content has moved into the Mac Admins Europe
            archive so the community can continue to find the program, speakers,
            sponsors, and Leiden venue details in one clear place.
          </p>
          <p>
            Mac Admins Europe remains a European, community-driven gathering for
            Apple admins and IT professionals. The archive preserves the work
            shared on stage and the partners who helped make the day possible.
          </p>
          <ul class="about-features">
            <li>
              <span class="feature-icon">⌘</span>
              <span><strong>Program</strong> - Review the 2026 schedule and sessions</span>
            </li>
            <li>
              <span class="feature-icon">⌘</span>
              <span><strong>Speakers</strong> - Browse names, bios, and session titles</span>
            </li>
            <li>
              <span class="feature-icon">⌘</span>
              <span><strong>Sponsors</strong> - Revisit the partners who supported the event</span>
            </li>
          </ul>
        </div>
        <div class="about-visual">
          <div class="visual-card">
            <video
              class="ring-video"
              autoplay
              muted
              loop
              playsinline
            >
              <source src={`${base}/video-header.mp4`} type="video/mp4" />
            </video>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="archive-home-links">
    <div class="container">
      <div class="text-center">
        <span class="section-label">Explore</span>
        <h2 class="section-title">Mac Admins Europe Archive</h2>
        <p class="section-subtitle">
          Start with the 2026 archive or browse the full previous-years index.
        </p>
      </div>

      <div class="archive-link-grid">
        <a href={`${base}/2026`} class="archive-link-card">
          <span>2026 Archive</span>
          <p>Program, speakers, sponsors, and Leiden location details.</p>
        </a>
        <a href={`${base}/previous-years`} class="archive-link-card">
          <span>Previous Years</span>
          <p>A year-by-year index for Mac Admins Europe archives.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
