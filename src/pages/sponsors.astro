---
import Layout from "../layouts/Layout.astro";
import { getBaseUrl } from "../utils/baseUrl";

const base = getBaseUrl();


// ============================================================
// CURRENT SPONSORS - Edit this array to add/update sponsors
// Put sponsor logos in /public/img/sponsors/
// tier: "platinum" | "gold" | "silver" | "patron"
// ============================================================
interface Sponsor {
  name: string;
  tier: "platinum" | "gold" | "silver" | "patron";
  logo?: string;
  url?: string;
  tagline?: string;
}
type SponsorTier = Sponsor["tier"];

const currentSponsors: Sponsor[] = [
  // Platinum
  {
    name: "Jamf",
    tier: "platinum",
    logo: "/img/sponsors/jamfdark.png",
    url: `${base}/sponsors/jamf`,
    tagline: "",
  },
  {
    name: "Iru",
    tier: "platinum",
    logo: "/img/sponsors/irulogo.png",
    url: `${base}/sponsors/iru`,
    tagline: "",
  },
  {
    name: "Fleetdm",
    tier: "platinum",
    logo: "/img/sponsors/fleet-logo-dark-rgb.png",
    url: `${base}/sponsors/fleetdm`,
    tagline: "",
  },

  // Gold
